# Plantilla de configuración para PRODUCCIÓN (Clase 15).
# Copiar como .env en el servidor y completar los valores.
# NUNCA subir el .env real a GitHub.

APP_NAME="QuickFood ERP"
APP_ENV=production
# Generar en el servidor con: php artisan key:generate
APP_KEY=
# false: los errores NO muestran código ni contraseñas al usuario
APP_DEBUG=false
APP_URL=https://erp.midominio.com
APP_LOCALE=es
# Sin carpeta lang/es, Laravel usa los mensajes en inglés del respaldo (en);
# con "es" mostraría claves como validation.required
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp_app
# Contraseña larga y única; el usuario de BD solo con permisos sobre la base erp
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Solo enviar la cookie de sesión por HTTPS
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Correo real (ej.: SMTP del proveedor de hosting o un servicio transaccional)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@midominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Parámetros del negocio (config/erp.php)
ERP_LOW_STOCK=5
ERP_DAILY_SUMMARY_AT=19:00
